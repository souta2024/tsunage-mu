<%- if controller_name != 'sessions' %>
  <%= link_to "ログイン画面へ", new_session_path(resource_name), class: "edit-link" %><br />
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to "Sign up", new_registration_path(resource_name), class: "edit-link" %><br />
<% end %>